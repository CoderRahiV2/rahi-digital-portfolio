rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_YOUR_ADMIN_UID";
    }
    match /evidence/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && userId == request.auth.uid
        && request.resource.size < 150 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('image/.*'));
    }
  }
}
