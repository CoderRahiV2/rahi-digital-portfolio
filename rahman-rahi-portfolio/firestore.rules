rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_YOUR_ADMIN_UID";
    }
    match /evidence/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
